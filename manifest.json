{
  "manifest_version": 3,
  "name": "Curiosity Pointer",
  "version": "1.2.2",
  "description": "Alt+Click any heading for a 2-sentence AI summary. Stay focused.",
  "permissions": ["activeTab", "storage", "scripting"],
  "options_page": "options.html",
  "icons": { "128": "icon128.png" },
  "action": { "default_icon": { "128": "icon128.png" } },
  "host_permissions": [
    "https://curiosity-pointer-api.vercel.app/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "all_frames": true
    }
  ]
}
